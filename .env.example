# Environment Variables Template
# Copy to .env or set these in your system/IDE Run Configuration.
# NEVER commit the actual .env file.

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/vegeai
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Redis (Spring Data Redis & Bucket4j)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT (Generate with: openssl rand -hex 64)
JWT_SECRET=replace-this-with-a-64-char-hex-secret-generated-by-openssl-rand-hex-64

# Mail (SMTP for OTP Verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
