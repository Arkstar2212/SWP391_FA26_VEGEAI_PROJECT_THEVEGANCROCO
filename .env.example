# ==============================================================================
# VEGEAI BACKEND CONFIGURATION TEMPLATE (.env)
# Copy this file to .env in the BACKEND directory.
# ==============================================================================

# ── 1. Database (PostgreSQL) ──────────────────────────────────────────────────
# KHI CHẠY DOCKER COMPOSE:
# DB_URL=jdbc:postgresql://postgres:5432/vegeai
#
# KHI CHẠY LOCAL (IntelliJ / mvn spring-boot:run):
DB_URL=jdbc:postgresql://localhost:5432/vegeai
DB_USERNAME=postgres
DB_PASSWORD=postgres

# KHI CHẠY SUPABASE (Cloud Database):
# DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.[your-project-ref]
# DB_PASSWORD=[your-supabase-db-password]

# ── 2. Redis (Cache, Blacklist & Rate Limiting) ───────────────────────────────
# KHI CHẠY DOCKER COMPOSE: REDIS_HOST=redis
# KHI CHẠY LOCAL: REDIS_HOST=localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── 3. Security & JWT Stateless Authentication ────────────────────────────────
JWT_SECRET=vegeai-super-secret-key-change-this-in-production-minimum-256-bits

# ── 4. Email (SMTP for OTP Verification) ──────────────────────────────────────
# Lưu ý: Nếu để trống MAIL_USERNAME/PASSWORD, hệ thống tự động in mã OTP ra Terminal/Console log để test nhanh!
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── 5. Google Gemini AI Studio ────────────────────────────────────────────────
# Đăng ký key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

